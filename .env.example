# Copy to .env.local and fill in. Never commit real values.
# Only the two NEXT_PUBLIC_ values are exposed to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # seed script + admin tasks only

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5 # override per route if needed
PERPLEXITY_API_KEY=
REVERSE_CONTACT_API_KEY=
HARMONIC_API_KEY=
VOYAGE_API_KEY=                   # embeddings, optional (Anthropic has no embeddings endpoint)
RESEND_API_KEY=                   # used by Supabase custom SMTP; optional app use

ADMIN_EMAILS=                     # comma-separated; can add people and reset data
